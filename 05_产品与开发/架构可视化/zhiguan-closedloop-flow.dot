digraph zhiguan_closedloop_flow {
  rankdir=LR;
  fontname="Microsoft YaHei";
  node [fontname="Microsoft YaHei", shape=box, style="rounded,filled", fillcolor="#f5f5f5", fontsize=11];
  edge [fontname="Microsoft YaHei", fontsize=9];
  labelloc="t";
  label="止观AI 一次闭环会话的调用顺序 — 先登记 → 采集 → 阈值 → 节拍 → VR → 落盘 → 质检\n证据底账＝architecture-model.json 的 service.experiment-session／module.closedloop-*／database.muse-report 节点族；轨二同事实的交互面＝qgraphflow/closedloop-session-sequence/index.html（2026-10-09，baseCommit 8124cce，七件文件工作区＝HEAD）";

  // ---- 人与登记册（先登记后采集，SOP V0.2）----
  fashi [label="宗国法师\n点开始／停止", shape=oval, fillcolor="#e1f5fe"];
  reg [label="01_registry/session_registry.csv\npreregister_locked :242-259\nS 号在跨进程临界区内分配", shape=cylinder, fillcolor="#ede7f6"];

  // ---- 编排层（驾驶舱）----
  exp [label="ExperimentSession\nconsole_server.py:1025-1182\n起线程·转推流·收口质检", fillcolor="#fff3e0"];

  // ---- 闭环三件（决策／执行）----
  run [label="run_closed_loop()\nclosedloop_experiment.py:250-634\n基线期→闭环期，每 decision_dt 一拍", fillcolor="#fffde7"];
  ctrl [label="ClosedLoopController\nclosedloop_controller.py:28-145\nAlpha 基线＋阈值 → (beat, vol, note)", fillcolor="#e8f5e9"];
  eng [label="IsoEngine\nclosedloop_engine.py:27-109\n载波×脉冲包络，热更新无爆音", fillcolor="#e8f5e9"];

  // ---- 信号真值面与落点 ----
  buf [label="DataBuffer\nmuse_local_server.py:340-1189\ncompute_band_power → latest_bp", fillcolor="#e0f2f1"];
  npz [label="report/local_{ts}.npz ＋ 中文报告\nmuse_local_server.py:889\n＝此前所称「暂存池」", shape=cylinder, fillcolor="#e0f2f1"];

  // ---- 反馈面与质检 ----
  vr [label="VRSession → /ws/vr\nconsole_server.py:1288-1300／:2202\n只送指标包，剥原始波形", fillcolor="#fce4ec"];
  qc [label="qc_pipeline.assess_cached\nqc_pipeline.py:482-512\n阈值版本 20260920", fillcolor="#f3e5f5"];

  // ---- 调用顺序（数字＝轨二序列图的 message 序号）----
  fashi -> reg  [label="1 preregister(P001, 类型, 日期)\n2 → S 号 | 409 重复 | 503 锁忙"];
  fashi -> exp  [label="3 POST /api/experiment/start"];
  exp -> run    [label="4 run_closed_loop(callback=_exp_relay,\nstop_event, session_info)"];
  run -> buf    [label="5 起数据源（BLE／TCP／模拟 四选一）\n7 compute_band_power()"];
  buf -> run    [label="8 latest_bp {delta,theta,alpha,beta,gamma}"];
  run -> ctrl   [label="9 基线期 add_baseline(alpha)\n11 闭环期 update(bp)"];
  ctrl -> run   [label="12 (beat_hz, volume, note)\nθ/β 自适应＋步长限幅"];
  run -> eng    [label="6 start()　10 基线期 idle 值\n13/14 set_beat(beat)·set_volume(vol)"];
  run -> exp    [label="15 每拍 callback{tick, beat, vol}\n20 callback{end, data_path}"];
  exp -> vr     [label="16 SSE publish ＋ push_from_experiment"];
  run -> npz    [label="18 save_bin(extra_meta{scene,\nzx_phase}) 19 → (data, report)"];
  exp -> qc     [label="21 qc_assess(data_path)"];
  qc -> exp     [label="22 {recommend, reasons, clean_ratio}"];
  exp -> exp    [label="23 session_contract：qc_done＋closed\n＋vr_interaction（附属物，失败不阻断）"];

  // ---- 两处如实留白（无据不画线）----
  gap [label="收口后另有一跳 congci_pipeline.enqueue\nconsole_server.py:1152 —— 本图不画：\n该文件带他窗在途 +45 行，锚点会漂\n且从此线节点族入台账＝丙案候裁（D-1008-W3b §八.1）\n细节见 congci-feed-sequence 视图", shape=note, fillcolor="#fff9c4", fontsize=9];
  exp -> gap [style=dashed, color="#9e9e9e", label="不建边，只留注"];

  sound [label="受试者实际听到的是 IsoEngine 的等时节拍\n载波 220Hz × beat Hz 脉冲；本图不画 sounddevice\n（框架行为，项目代码内不可见）", shape=note, fillcolor="#eceff1", fontsize=9];
  eng -> sound [style=dashed, color="#9e9e9e", label="framework"];
}
